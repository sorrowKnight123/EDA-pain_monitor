# 本仓库只跟踪代码，其余内容（设计文档、申报材料、海报素材、重建脚本草稿）
# 一律不入库。新增非代码文件无需改此文件，天然被排除。
/*
!/code/
!/.gitignore

# Python 产物
__pycache__/
*.py[cod]
.venv/

# 录制数据：含患者信息，绝不可入库
code/up/recordings/

# STM32CubeIDE 构建输出（IDE 构建时自动重新生成）
Debug/
Release/

# tools/build_check.ps1 的临时编译/链接产物
code/firmware/build_check/

# 一次性校验用临时目录
code/firmware/.verify_tmp/

# 性能对比构建临时目录
code/firmware/.perf/
